---
import Pagina from '../layouts/Pagina.astro';
import cliente from '../content/cliente.json';
---
<Pagina cliente={cliente} adn={cliente.adn} titulo={`Nosotros | ${cliente.nombre}`} descripcion={`Quiénes somos: ${cliente.nombre}.`} actual="/nosotros/">
  <h1 class="rv text-[clamp(2.5rem,7vw,6rem)]">Quiénes somos</h1>
  <p class="rv mt-10 max-w-2xl whitespace-pre-line text-lg">{cliente.equipo}</p>
</Pagina>
