---
import Pagina from '../../layouts/Pagina.astro';
import cliente from '../../content/cliente.json';
import { slug } from '../../lib/sitio.js';

const servicios: { titulo: string; texto: string }[] = cliente.servicios;
const conDetalle = cliente.detalleServicios === true;
---
<Pagina cliente={cliente} adn={cliente.adn} titulo={`Servicios | ${cliente.nombre}`} descripcion={`Servicios de ${cliente.nombre} en ${cliente.direccion}.`} actual="/servicios/">
  <h1 class="rv text-[clamp(2.5rem,7vw,6rem)]">{cliente.etiquetaServicios}</h1>
  <ol class="mt-12 grid gap-4 md:grid-cols-2">
    {servicios.map((s, i) => (
      <li class="tarjeta rv p-6 md:p-8" style={`--i:${i}`}>
        <span class="titulo text-accent">{String(i + 1).padStart(2, '0')}</span>
        <h2 class="mt-3 text-2xl md:text-3xl">{s.titulo}</h2>
        <p class="mt-3 text-muted">{s.texto}</p>
        {conDetalle && (
          <a class="mt-6 inline-flex min-h-11 items-center underline underline-offset-4" href={`/servicios/${slug(s.titulo)}/`}>
            Ver detalle de {s.titulo}
          </a>
        )}
      </li>
    ))}
  </ol>
</Pagina>
