---
import '../styles/fonts.css';
import '../styles/global.css';

interface Props { adn: any; titulo: string; descripcion: string }
const { adn, titulo, descripcion } = Astro.props;
const estiloInline = Object.entries(adn.vars).map(([k, v]) => `${k}:${v}`).join(';');
---
<!doctype html>
<html lang="es" data-estilo={adn.estilo} style={estiloInline}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content={adn.vars['--bg']} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:locale" content="es_AR" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body data-anim={adn.animacion}>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <slot />
    <script is:inline>
      const els = document.querySelectorAll('.rv');
      if (!('IntersectionObserver' in window)) els.forEach((e) => e.classList.add('in'));
      else {
        const io = new IntersectionObserver((es) => es.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }), { threshold: 0.12 });
        els.forEach((e) => io.observe(e));
      }
    </script>
  </body>
</html>
